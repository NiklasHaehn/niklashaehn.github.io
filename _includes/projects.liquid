<div class="project-list-item py-3 border-bottom">
  <h3 class="mb-1">
    <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {{ project.title }}
    </a>
  </h3>
  {% if project.description %}
    <p class="text-muted mb-0">{{ project.description }}</p>
  {% endif %}
</div>
