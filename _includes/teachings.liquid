<div class="teaching-list-item py-3 border-bottom">
  <h3 class="mb-1">
    <a href="{% if teaching.redirect %}{{ teaching.redirect }}{% else %}{{ teaching.url | relative_url }}{% endif %}">
      {{ teaching.title }}
    </a>
  </h3>
  {% if teaching.description %}
    <p class="text-muted mb-0">{{ teaching.description }}</p>
  {% endif %}
</div>
